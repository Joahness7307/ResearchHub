{
  "name": "researchhub-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",

    "dev":        "nodemon --env-file=.env.local       server.js",
    "dev:branch": "nodemon --env-file=.env.development server.js",
    "dev:prod":   "nodemon --env-file=.env.production  server.js",

    "migrate":        "dotenv -e .env.local       -- sequelize-cli db:migrate",
    "migrate:branch": "dotenv -e .env.development -- sequelize-cli db:migrate",
    "migrate:prod":   "dotenv -e .env.production  -- sequelize-cli db:migrate",

    "migrate:undo":        "dotenv -e .env.local       -- sequelize-cli db:migrate:undo",
    "migrate:undo:branch": "dotenv -e .env.development -- sequelize-cli db:migrate:undo",
    "migrate:undo:prod":   "dotenv -e .env.production  -- sequelize-cli db:migrate:undo",

    "seed":           "dotenv -e .env.local       -- sequelize-cli db:seed:all",
    "seed:branch":    "dotenv -e .env.development -- sequelize-cli db:seed:all",
    "seed:prod":      "dotenv -e .env.production  -- sequelize-cli db:seed:all",

    "seed:undo":          "dotenv -e .env.local       -- sequelize-cli db:seed:undo:all",
    "seed:undo:branch":   "dotenv -e .env.development -- sequelize-cli db:seed:undo:all",
    "seed:undo:prod":     "dotenv -e .env.production  -- sequelize-cli db:seed:undo:all",

    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  }
}
