# === ROOT LEVEL (RESEARCHHUB/.gitignore) ===
# This one wins everywhere because it's in the root

# Dependency directories (covers frontend, backend, and any future packages)
node_modules/
**/node_modules/

# Lock files (let each package manage its own)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
build/
dist/
out/
.vercel
.netlify

# Environment files & config — never commit these
.env
.env.local
.env.development
.env.production
.env.*
config/*.local.json

# Logs & temp files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor & OS junk
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cache files
.eslintcache
.stylelintcache
.prettierecache
.cache