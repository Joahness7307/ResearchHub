# ROOT .gitignore

# 1. NODE DEPENDENCIES (Most critical for poly-repo structure)
# This will ignore ALL node_modules folders in every directory.
# If a dependency folder exists in /frontend, /backend, or /root, it's ignored.
node_modules
/package-lock.json
/yarn.lock

# 2. LOGS & ARTIFACTS
logs
*.log
npm-debug.log*
.eslintcache

# 3. OS and EDITOR FILES
.DS_Store # macOS
.vscode/ # VS Code settings specific to THIS user's workspace