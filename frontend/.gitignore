# FRONTEND .gitignore (Inside ./frontend)

# 1. Build Folders
# Ignore the output of your build process.
/build 
/dist 
/out 

# 2. Local Configuration
# Ignore configuration files that are only used locally
.env
.env.local
.env.*.local

# 3. Test/Coverage
/coverage

# NOTE: node_modules is likely already ignored by the root .gitignore, 
# but adding it here is good practice if you ever split the repository.
# node_modules